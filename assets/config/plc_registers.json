{
  "version": "1.1",
  "description": "Parfüm Kiosk PLC Register Haritası v1.1",
  "last_updated": "2026-06-12",
  "connection": {
    "host": "192.168.1.105",
    "port": 5020,
    "slave_id": 1,
    "timeout_ms": 3000,
    "retry_count": 3
  },
  "registers": {
    "commands": {
      "description": "Flutter→PLC komutları (Blok 1)",
      "type": "write",
      "addresses": {
        "action": 100,
        "slot": 101,
        "sequence_id": 102
      },
      "data_type": "uint16",
      "min_value": 0,
      "max_value": 65535,
      "values": {
        "action": {
          "0": "Boşta",
          "1": "Tester Bas",
          "2": "Ödeme Başlat",
          "3": "Satış Bas",
          "4": "Sistem Sıfırla",
          "5": "Oturumu İptal Et"
        }
      }
    },
    "system_status": {
      "description": "PLC→Flutter sistem durumu (Blok 2)",
      "type": "read",
      "addresses": {
        "system": 200,
        "last_cmd_seq_id": 201,
        "last_cmd_result": 202,
        "active_slot": 203
      },
      "data_type": "uint16",
      "values": {
        "system": {
          "0": "Boşta",
          "1": "Meşgul",
          "2": "Hata"
        },
        "last_cmd_result": {
          "0": "Başarılı",
          "1": "Başarısız"
        }
      }
    },
    "payment": {
      "description": "Ödeme sistemi (Blok 3)",
      "type": "read_write",
      "addresses": {
        "status": 300,
        "amount": 301,
        "confirmed_ack": 302,
        "sale_completed": 303
      },
      "data_type": "uint16",
      "values": {
        "status": {
          "0": "Bekliyor",
          "1": "Onaylandı",
          "2": "Reddedildi",
          "3": "Timeout"
        }
      }
    },
    "sensors": {
      "description": "Varlık ve stok sensörleri (Blok 4)",
      "type": "read",
      "addresses": {
        "presence": 400,
        "stock_1": 401,
        "stock_2": 402,
        "stock_3": 403,
        "stock_4": 404,
        "stock_5": 405,
        "stock_6": 406,
        "stock_7": 407,
        "stock_8": 408,
        "stock_9": 409,
        "stock_10": 410,
        "stock_11": 411,
        "stock_12": 412,
        "stock_13": 413,
        "stock_14": 414,
        "stock_15": 415,
        "stock_16": 416,
        "stock_17": 417,
        "stock_18": 418,
        "stock_19": 419,
        "stock_20": 420,
        "stock_21": 421,
        "stock_22": 422,
        "stock_23": 423,
        "stock_24": 424
      },
      "data_type": "uint16",
      "values": {
        "presence": {
          "0": "Kullanıcı Yok",
          "1": "Kullanıcı Var"
        },
        "stock": {
          "0": "Boş",
          "1": "Dolu"
        }
      }
    },
    "errors": {
      "description": "Hata kayıtları (Blok 5) — iki bağımsız hata slotu + Flutter ACK",
      "type": "read_write",
      "addresses": {
        "error_code":   500,
        "error_slot":   501,
        "error_code_2": 502,
        "error_slot_2": 503,
        "error_ack":    504
      },
      "data_type": "uint16",
      "values": {
        "error_code": {
          "0": "Hata Yok",
          "1": "Pompa Arıza",
          "2": "Dispenser Arıza",
          "3": "Stok Boş",
          "4": "Terminal Arıza",
          "5": "Ödeme Timeout",
          "6": "Aşırı Isınma"
        }
      }
    },
    "heartbeat": {
      "description": "Çift yönlü heartbeat (Blok 6)",
      "type": "read_write",
      "addresses": {
        "plc_heartbeat": 600,
        "flutter_heartbeat": 601
      },
      "data_type": "uint16",
      "min_value": 0,
      "max_value": 65535
    }
  },
  "workflows": {
    "tester_preparation": [
      "commands.action",
      "commands.slot",
      "commands.sequence_id",
      "system_status.system"
    ],
    "payment_flow": [
      "payment.amount",
      "payment.status",
      "payment.confirmed_ack"
    ],
    "dispense_perfume": [
      "commands.action",
      "commands.slot",
      "payment.sale_completed"
    ]
  },
  "validation": {
    "required_registers": [
      "commands.action",
      "system_status.system",
      "payment.status",
      "heartbeat.plc_heartbeat"
    ],
    "critical_errors": [
      "errors.error_code",
      "errors.error_slot"
    ]
  }
}
